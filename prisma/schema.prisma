generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String    @id
  name            String    @unique
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  role            String    @default("user")
  username        String?   @unique
  displayUsername String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Caregiver {
  id                String   @id @default(cuid())
  name              String?
  phone             String   @unique
  email             String?
  address           String?
  city              String?
  state             String?
  zip               String?
  preferredLanguage String?
  status            String   @default("ACTIVE")
  currentWorkflowId String?
  currentStepId     String?
  firstContactDate  DateTime @default(now())
  lastInteraction   DateTime?
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  keywords    CaregiverKeyword[]
  messages    Message[]
  messageLogs MessageLog[]
  notes       CaregiverNote[]
  aiResponses AiResponseLog[]

  @@index([status])
  @@map("caregiver")
}

model CaregiverKeyword {
  id          String   @id @default(cuid())
  caregiverId String
  keyword     String
  createdAt   DateTime @default(now())

  caregiver Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  @@unique([caregiverId, keyword])
  @@index([keyword])
  @@map("caregiver_keyword")
}

model CaregiverNote {
  id          String   @id @default(cuid())
  caregiverId String
  body        String
  authorName  String   @default("Admin User")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  caregiver Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  @@index([caregiverId, createdAt])
  @@map("caregiver_note")
}

model Workflow {
  id             String   @id
  name           String
  description    String?
  status         String   @default("draft")
  isActive       Boolean  @default(true)
  publishedAt    DateTime?
  selectedStepId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  steps MessageWorkflowStep[]

  @@index([status])
  @@map("workflow")
}

model MessageWorkflowStep {
  id         String   @id
  workflowId String
  type       String
  title      String
  keyword    String?
  contentEn  String   @default("")
  contentEs  String   @default("")
  nextStepId String?
  positionX  Int      @default(0)
  positionY  Int      @default(0)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workflow Workflow               @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  options  MessageWorkflowOption[]

  @@index([workflowId, sortOrder])
  @@index([workflowId, type])
  @@map("workflow_step")
}

model MessageWorkflowOption {
  id           String   @id
  stepId       String
  labelEn      String   @default("")
  labelEs      String   @default("")
  replyValue   String
  targetStepId String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  step MessageWorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId, sortOrder])
  @@map("workflow_option")
}

model Message {
  id                String   @id @default(cuid())
  caregiverId       String?
  phone             String
  contactName       String   @default("Unknown Sender")
  messageText       String
  normalizedText    String?
  direction         String
  keywordDetected   String?
  language          String?
  workflowId        String?
  workflowStepId    String?
  providerName      String?
  providerMessageId String?
  sentAt            DateTime?
  receivedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  caregiver Caregiver? @relation(fields: [caregiverId], references: [id], onDelete: SetNull)
  logs      MessageLog[]
  aiResponses AiResponseLog[]

  @@index([caregiverId, createdAt])
  @@index([phone, createdAt])
  @@index([workflowId])
  @@index([workflowStepId])
  @@map("message")
}

model SystemSettings {
  id                        String   @id @default("singleton")
  smsProvider               String   @default("twilio")
  twilioAccountSid          String   @default("")
  twilioAuthToken           String   @default("")
  twilioPhoneNumber         String   @default("")
  twilioMessagingServiceSid String   @default("")
  defaultResponseMessage    String   @default("Thank you for contacting the Shaken Baby Alliance COPE Support System. We're here to help.")
  systemActive              Boolean  @default(true)
  chatbotEnabled            Boolean  @default(true)
  aiEnabled                 Boolean  @default(false)
  aiProvider                String   @default("gemini")
  aiApiKey                  String   @default("")
  aiModel                   String   @default("gemini-2.5-flash")
  autoArchiveMessages       Boolean  @default(true)
  autoArchiveDays           Int      @default(90)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("system_settings")
}

model MessageLog {
  id                String   @id @default(cuid())
  messageId         String?
  caregiverId       String?
  phone             String
  contactName       String   @default("Unknown Sender")
  eventType         String   @default("MESSAGE")
  status            String   @default("PENDING")
  direction         String?
  providerName      String?
  providerMessageId String?
  providerResponse  String?
  errorMessage      String?
  details           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  message   Message?   @relation(fields: [messageId], references: [id], onDelete: SetNull)
  caregiver Caregiver? @relation(fields: [caregiverId], references: [id], onDelete: SetNull)

  @@index([messageId, createdAt])
  @@index([caregiverId, createdAt])
  @@index([phone, createdAt])
  @@map("message_log")
}

model AiKnowledgeEntry {
  id        String   @id @default(cuid())
  title     String
  category  String
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks AiKnowledgeChunk[]

  @@index([active])
  @@index([category])
  @@map("ai_knowledge_entry")
}

model AiKnowledgeChunk {
  id                 String    @id @default(cuid())
  entryId            String
  chunkText          String
  chunkHash          String
  tokenCount         Int       @default(0)
  embeddingJson      String?
  embeddingModel     String?
  embeddingProvider  String?
  embeddingDimension Int?
  embeddedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  entry AiKnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, chunkHash])
  @@index([entryId])
  @@index([embeddingModel])
  @@map("ai_knowledge_chunk")
}

model AiResponseLog {
  id              String   @id @default(cuid())
  messageId        String?
  caregiverId      String?
  phone            String
  userMessage      String
  aiResponse       String?
  matchedEntryIds  String?
  matchedChunkIds  String?
  retrievalMode    String?
  embeddingModel   String?
  emergencyFlag    Boolean  @default(false)
  provider         String
  model            String
  status           String   @default("SUCCESS")
  errorMessage     String?
  createdAt        DateTime @default(now())

  message   Message?   @relation(fields: [messageId], references: [id], onDelete: SetNull)
  caregiver Caregiver? @relation(fields: [caregiverId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([caregiverId])
  @@index([phone])
  @@map("ai_response_log")
}
